# Copy to `.env` (never commit `.env`!) for remote Slurm cluster sync & execution.
BIGMAMA_HOST=cluster.example.edu
BIGMAMA_USER=your_cluster_username
BIGMAMA_PASS=
BIGMAMA_REMOTE_DIR=~/SRP26

# Optional overrides for Hugging Face cache and benchmark datasets directory
HF_HOME=~/.cache/huggingface
SRP26_DATA_DIR=

